# Copy to .env.local and edit. Vite only exposes variables that start with VITE_.
# true  = in-browser demo data (no backend needed)
# false = talk to the real API
VITE_DEMO_MODE=false
# Real API address. Leave empty to use the same origin (local dev proxy / Node gateway).
# Example for Phase 2: https://api.your-domain.com
VITE_API_BASE_URL=
